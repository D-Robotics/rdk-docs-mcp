{
  "name": "rdk-docs-mcp",
  "version": "0.2.0",
  "type": "module",
  "description": "RDK Assistant MCP: official documentation, verified Skill discovery, and installation guidance.",
  "bin": {
    "rdk-docs-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "install.md",
    "SKILL.md",
    "skills"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:live": "npm run build && node dist/eval-live.js",
    "eval:skills": "npm run build && node dist/eval-skills-live.js",
    "verify": "npm test && npm run build",
    "prepack": "node scripts/prepack.mjs",
    "prepublishOnly": "npm test && npm run build && npm run prepack",
    "verify:live": "npm run eval:live && npm run eval:skills",
    "verify:package": "npm run build && node scripts/verify-package.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "node-html-parser": "^7.0.1",
    "smol-toml": "^1.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/D-Robotics/rdk-docs-mcp.git"
  },
  "homepage": "https://github.com/D-Robotics/rdk-docs-mcp#readme",
  "bugs": {
    "url": "https://github.com/D-Robotics/rdk-docs-mcp/issues"
  },
  "keywords": [
    "mcp",
    "rdk",
    "d-robotics",
    "documentation",
    "forum",
    "skills",
    "tros"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
