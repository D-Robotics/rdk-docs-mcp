{
  "name": "rdk-docs-mcp",
  "version": "0.4.0",
  "type": "module",
  "description": "Search RDK documentation and Skills, and publish cases, Skills and forum posts as the signed-in user.",
  "bin": {
    "rdk-docs-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "prebuilt",
    "README.md",
    "LICENSE",
    "install.md",
    "CHANGELOG.md",
    "SKILL.md",
    "skills",
    "community.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "npm run build && node dist/eval-retrieval.js",
    "eval:offline": "npm run build && node dist/eval-retrieval.js --offline",
    "eval:paraphrase": "npm run build && node dist/eval-retrieval.js --offline --cases eval/paraphrase-cases.json --out eval/paraphrase-after.json",
    "build:index": "npm run build && node dist/build-prebuilt.js",
    "eval:live": "npm run build && node dist/eval-live.js",
    "eval:skills": "npm run build && node dist/eval-skills-live.js",
    "verify": "npm test && npm run eval:live",
    "prepack": "rm -rf ./skills && cp -R ../skills ./skills && cp ../skills/rdk-docs/SKILL.md ./SKILL.md",
    "prepublishOnly": "npm test && npm run build && npm run prepack"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "node-html-parser": "^7.0.1",
    "smol-toml": "^1.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/D-Robotics/rdk-docs-mcp.git"
  },
  "homepage": "https://github.com/D-Robotics/rdk-docs-mcp#readme",
  "bugs": {
    "url": "https://github.com/D-Robotics/rdk-docs-mcp/issues"
  },
  "keywords": [
    "mcp",
    "rdk",
    "d-robotics",
    "documentation",
    "forum",
    "skills",
    "tros"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
